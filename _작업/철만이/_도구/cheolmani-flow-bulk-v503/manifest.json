{
  "manifest_version": 3,
  "name": "철만이 Flow 벌크 오퍼레이터",
  "version": "5.0.3",
  "description": "Google Labs Flow 자동화 벌크 생성 오퍼레이터 도구입니다.",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://labs.google/*"
  ],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://labs.google/*"],
      "js": ["content.js"]
    }
  ]
}
