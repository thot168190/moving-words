import React, { useState, useEffect, useCallback } from 'react';
import { PORTONE_CONFIG, generatePaymentId } from '../../lib/portone';

declare global {
  interface Window {
    PortOne?: {
      requestPayment: (options: any) => Promise<any>;
    };
  }
}

interface PortOneCheckoutButtonProps {
  amount?: number;
  orderName?: string;
  customerEmail?: string;
  customerName?: string;
  onError?: (error: any) => void;
  className?: string;
}

const PortOneCheckoutButton: React.FC<PortOneCheckoutButtonProps> = ({
  amount = 9900,
  orderName = '보는 단어장 출시 기념 이용권',
  customerEmail,
  customerName,
  onError,
  className,
}) => {
  const [processing, setProcessing] = useState(false);


  useEffect(() => {
    if (window.PortOne) return;

    const existing = document.querySelector('script[src*="portone.io"]');
    if (existing) return;

    const script = document.createElement('script');
    script.src = 'https://cdn.portone.io/v2/browser-sdk.js';
    script.async = true;
    script.onload = () => {
      console.log('[PortOne] SDK Loaded via script tag');
    };
    script.onerror = () => {
      console.error('[PortOne] SDK 로드 실패');
      onError?.('포트원 SDK 로드 실패');
    };
    document.head.appendChild(script);
  }, [onError]);


  const handlePayment = useCallback(async () => {
    if (!window.PortOne) {
      alert('포트원 모듈 로딩 중입니다. 1~2초 후 다시 시도해 주세요.');
      return;
    }
    
    if (processing) return;

    const storeId = PORTONE_CONFIG.storeId || 'store-04d68797-1bc3-47a4-8254-ff9ee66a532d';
    const channelKey = PORTONE_CONFIG.channelKey || 'channel-key-bf425a72-5f69-4c25-bd5b-890777729176';

    setProcessing(true);

    try {
      const paymentId = generatePaymentId();
      
      // PortOne V2 표준 호출 파라미터 (channelKey 지정 시 결제수단 자동 매칭)
      const paymentOptions: any = {
        storeId,
        channelKey,
        paymentId,
        orderName,
        totalAmount: amount,
        currency: 'CURRENCY_KRW',
        redirectUrl: PORTONE_CONFIG.redirectUrl,
        customer: {
          fullName: customerName || '고객',
          email: customerEmail || undefined,
        },
      };

      console.log('[PortOne] Requesting payment options:', paymentOptions);

      const response = await window.PortOne.requestPayment(paymentOptions);

      console.log('[PortOne] Response received:', response);

      if (response && response.code != null) {
        if (response.code !== 'USER_CANCEL') {
          alert(`포트원 결제 결과: ${response.message || response.code}`);
          onError?.(response.message || '결제 실패');
        } else {
          console.log('[PortOne] 결제창 사용자 취소');
        }
      }
    } catch (error: any) {
      console.error('[PortOne] Exception:', error);
      alert(`결제창 호출 오류: ${error?.message || error}`);
      onError?.(error?.message || error);
    } finally {
      setProcessing(false);
    }
  }, [amount, orderName, customerEmail, customerName, processing, onError]);

  return (
    <button
      onClick={handlePayment}
      disabled={processing}
      className={`
        w-full max-w-none mx-auto h-[68px] rounded-[18px] font-black text-[20px]
        flex items-center justify-center gap-2
        transition-all duration-200 shadow-sm hover:shadow-md
        ${processing
          ? 'bg-[#8BB7A7] cursor-wait'
          : 'bg-[#07533F] hover:bg-[#0B684F] active:bg-[#064534] active:scale-[0.97] cursor-pointer'
        }
        text-white border-none
        ${className || ''}
      `}
    >
      {processing ? (
        <>
          <svg className="animate-spin h-5 w-5" viewBox="0 0 24 24" fill="none">
            <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" />
            <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
          </svg>
          <span>결제 처리 중...</span>
        </>
      ) : (
        <>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" className="mr-0.5">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>₩{amount.toLocaleString()} 시작하기</span>
        </>
      )}
    </button>
  );
};

export default PortOneCheckoutButton;
